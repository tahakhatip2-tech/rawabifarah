# ============================================================
# BAKERY PLATFORM — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/bakery_db?retryWrites=true&w=majority"

# ── Authentication (NextAuth v5) ──────────────────────────────
AUTH_SECRET="your-secret-key-minimum-32-characters-long"
AUTH_URL="http://localhost:3000"

# ── App Settings ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="روابي الفرح"
NEXT_PUBLIC_DEFAULT_CURRENCY="JOD"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
DEFAULT_TIMEZONE="Asia/Amman"

# ── File Storage (Cloudinary) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@rawabifarah.com"

# ── Payment Gateway ───────────────────────────────────────────
# MyFatoorah (Kuwait/Jordan)
MYFATOORAH_API_KEY=""
MYFATOORAH_BASE_URL="https://apitest.myfatoorah.com"

# ── WhatsApp Business ─────────────────────────────────────────
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"
