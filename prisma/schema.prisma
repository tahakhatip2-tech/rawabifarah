// ============================================================
// BAKERY PLATFORM â€” Prisma Schema (MongoDB)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// ENUMS
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
  BRANCH_MANAGER
  CASHIER
  WAREHOUSE_STAFF
  PRODUCTION_STAFF
  CONTENT_MANAGER
  CUSTOMER
  MERCHANT
  SUPPLIER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  REJECTED
  REFUNDED
}

enum OrderChannel {
  ONLINE
  POS
  WHOLESALE
  B2B
}

enum PaymentMethod {
  CASH
  CARD
  MYFATOORAH
  BANK_TRANSFER
  CREDIT
  STORE_CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
}

enum MovementType {
  SALE
  PURCHASE_RECEIPT
  PRODUCTION_INPUT
  PRODUCTION_OUTPUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  WASTE
  RETURN_IN
  RETURN_OUT
  INITIAL
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransferStatus {
  PENDING
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MAINTENANCE
  MARKETING
  SUPPLIES
  TRANSPORT
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// BUSINESS & BRANCHES
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model Business {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  nameAr      String
  nameEn      String
  logo        String?
  phone       String?
  email       String?
  address     Json?
  settings    Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches    Branch[]
  employees   Employee[]
}

model Branch {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId  String   @db.ObjectId
  nameAr      String
  nameEn      String
  address     Json
  phone       String?
  email       String?
  hours       Json?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business      @relation(fields: [businessId], references: [id])
  warehouses      Warehouse[]
  employees       Employee[]
  posSessions     POSSession[]
  salesOrders     SalesOrder[]
  productionOrders ProductionOrder[]
  transfers       StockTransfer[] @relation("FromBranch")
  transfersIn     StockTransfer[] @relation("ToBranch")
  expenses        Expense[]
}

model Warehouse {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  branchId    String   @db.ObjectId
  nameAr      String
  nameEn      String
  type        String   @default("GENERAL") // GENERAL | PRODUCTION | COLD_STORAGE
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  branch          Branch          @relation(fields: [branchId], references: [id])
  inventoryItems  InventoryItem[]
  transfersFrom   StockTransfer[] @relation("FromWarehouse")
  transfersTo     StockTransfer[] @relation("ToWarehouse")
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// USERS, ROLES & PERMISSIONS
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  permissions  String[] @default([])
  branchId     String?  @db.ObjectId
  businessId   String?  @db.ObjectId
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee        Employee?
  customer        Customer?
  merchant        MerchantAccount?
  supplier        Supplier?
  auditLogs       AuditLog[]
  posSessions     POSSession[]
  stockMovements  StockMovement[]
  stockAdjustments StockAdjustment[]
  newsPosts        NewsPost[]
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// EMPLOYEES & HR
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model Employee {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  businessId    String   @db.ObjectId
  branchId      String   @db.ObjectId
  nameAr        String
  nameEn        String
  phone         String?
  nationalId    String?
  jobTitle      String
  department    String?
  employmentType String  @default("FULL_TIME")
  startDate     DateTime
  endDate       DateTime?
  baseSalary    Float  
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  business        Business          @relation(fields: [businessId], references: [id])
  branch          Branch            @relation(fields: [branchId], references: [id])
  attendanceRecords AttendanceRecord[]
  leaveRequests   LeaveRequest[]
  shifts          EmployeeShift[]
}

model EmployeeShift {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String   @db.ObjectId
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  type        String   @default("REGULAR")
  notes       String?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id])
}

model AttendanceRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String   @db.ObjectId
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  breakMinutes Int     @default(0)
  status      String   @default("PRESENT") // PRESENT | ABSENT | LATE | HALF_DAY
  notes       String?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id])
}

model LeaveRequest {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String      @db.ObjectId
  type        String      // ANNUAL | SICK | EMERGENCY | UNPAID
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?     @db.ObjectId
  approvedAt  DateTime?
  createdAt   DateTime    @default(now())

  employee    Employee    @relation(fields: [employeeId], references: [id])
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// CUSTOMERS & CRM
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model Customer {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  nameAr        String
  nameEn        String?
  phone         String?
  birthDate     DateTime?
  gender        String?
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  addresses     Address[]
  salesOrders   SalesOrder[]
  loyaltyAccount LoyaltyAccount?
  ledgerEntries CustomerLedgerEntry[]
  feedbacks     CustomerFeedback[]
}

model Address {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String   @db.ObjectId
  label       String   @default("Home")
  line1       String
  line2       String?
  city        String
  area        String?
  isDefault   Boolean  @default(false)
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])
  deliveries  Delivery[]
}

model LoyaltyAccount {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String   @unique @db.ObjectId
  points      Int      @default(0)
  tier        String   @default("BRONZE") // BRONZE | SILVER | GOLD | PLATINUM
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer     Customer           @relation(fields: [customerId], references: [id])
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  loyaltyAccountId String   @db.ObjectId
  type             String   // EARN | REDEEM | EXPIRE | ADJUST
  points           Int
  balanceBefore    Int
  balanceAfter     Int
  referenceType    String?
  referenceId      String?  @db.ObjectId
  notes            String?
  createdAt        DateTime @default(now())

  loyaltyAccount  LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id])
}

model CustomerFeedback {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String   @db.ObjectId
  orderId     String?  @db.ObjectId
  rating      Int      // 1-5
  comment     String?
  type        String   @default("REVIEW") // REVIEW | COMPLAINT | SUGGESTION
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// MERCHANT / B2B
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model MerchantAccount {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String         @unique @db.ObjectId
  businessName    String
  contactName     String
  phone           String
  email           String?
  taxNumber       String?
  address         Json?
  status          MerchantStatus @default(PENDING)
  creditLimit     Float         @default(0)
  creditTermDays  Int            @default(0)
  priceListId     String?        @db.ObjectId
  approvedBy      String?        @db.ObjectId
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id])
  priceList       MerchantPriceList? @relation(fields: [priceListId], references: [id])
  salesOrders     SalesOrder[]
  ledgerEntries   CustomerLedgerEntry[]
  quotations      Quotation[]
}

model MerchantPriceList {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  nameAr      String
  nameEn      String
  discount    Float   @default(0) // percentage off retail
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  merchants   MerchantAccount[]
  items       MerchantPriceItem[]
}

model MerchantPriceItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  priceListId   String   @db.ObjectId
  productId     String   @db.ObjectId
  price         Float  
  minQty        Int      @default(1)

  priceList     MerchantPriceList @relation(fields: [priceListId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
}

model Quotation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  merchantId      String   @db.ObjectId
  quotationNumber String   @unique
  status          String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED
  items           Json     // snapshot of items
  subtotal        Float  
  taxAmount       Float   @default(0)
  total           Float  
  validUntil      DateTime?
  notes           String?
  convertedOrderId String? @db.ObjectId
  createdAt       DateTime @default(now())

  merchant        MerchantAccount @relation(fields: [merchantId], references: [id])
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// PRODUCTS & CATALOG
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model ProductCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  parentId    String?  @db.ObjectId
  nameAr      String
  nameEn      String
  slug        String   @unique
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]
}

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  sku             String   @unique
  nameAr          String
  nameEn          String
  slug            String   @unique
  descriptionAr   String?
  descriptionEn   String?
  ingredientsAr   String?
  ingredientsEn   String?
  images          String[]
  categoryId      String   @db.ObjectId
  type            String   @default("FINISHED") // FINISHED | RAW_MATERIAL | PACKAGING | SEMI_FINISHED
  unit            String   @default("piece")
  weight          Float? 
  retailPrice     Float  
  costPrice       Float   @default(0)
  taxRate         Float   @default(16) // 16% JO VAT
  allergens       String[] @default([])
  shelfLifeHours  Int?
  minOrderQty     Int      @default(1)
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  isSeasonal      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        ProductCategory   @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  barcodes        Barcode[]
  recipe          Recipe?
  inventoryItems  InventoryItem[]
  orderItems      SalesOrderItem[]
  recipeIngredients RecipeIngredient[]
  priceItems      MerchantPriceItem[]
  wasteRecords    WasteRecord[]
  cartItems       CartItem[]
}

model ProductVariant {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  nameAr      String
  nameEn      String
  sku         String   @unique
  price       Float  
  costPrice   Float   @default(0)
  weight      Float? 
  isActive    Boolean  @default(true)

  product     Product  @relation(fields: [productId], references: [id])
  barcodes    Barcode[]
}

model Barcode {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String?  @db.ObjectId
  variantId   String?  @db.ObjectId
  code        String   @unique
  type        String   @default("EAN13")

  product     Product?        @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// INVENTORY
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model InventoryItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  productId     String   @db.ObjectId
  warehouseId   String   @db.ObjectId
  qtyOnHand     Float   @default(0)
  qtyReserved   Float   @default(0)
  reorderPoint  Float   @default(0)
  updatedAt     DateTime @updatedAt

  product       Product         @relation(fields: [productId], references: [id])
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])
  lots          InventoryLot[]
  movements     StockMovement[]

  @@unique([productId, warehouseId])
}

model InventoryLot {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  inventoryItemId String   @db.ObjectId
  lotNumber       String
  qty             Float  
  costPerUnit     Float  
  productionDate  DateTime?
  expiryDate      DateTime?
  supplierId      String?  @db.ObjectId
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model StockMovement {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  inventoryItemId String       @db.ObjectId
  type            MovementType
  qty             Float      
  qtyBefore       Float      
  qtyAfter        Float      
  unitCost        Float?     
  referenceType   String       // POS_SALE | ONLINE_ORDER | PURCHASE_RECEIPT | PRODUCTION | TRANSFER | ADJUSTMENT | WASTE
  referenceId     String?      @db.ObjectId
  reason          String?
  userId          String       @db.ObjectId
  branchId        String       @db.ObjectId
  createdAt       DateTime     @default(now())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
}

model StockAdjustment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  warehouseId String   @db.ObjectId
  userId      String   @db.ObjectId
  reason      String
  notes       String?
  status      String   @default("PENDING") // PENDING | APPROVED | APPLIED
  items       Json     // array of {productId, qtyExpected, qtyActual, difference}
  approvedBy  String?  @db.ObjectId
  approvedAt  DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model StockTransfer {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  transferNumber String        @unique
  fromBranchId  String         @db.ObjectId
  toBranchId    String         @db.ObjectId
  fromWarehouseId String       @db.ObjectId
  toWarehouseId String         @db.ObjectId
  status        TransferStatus @default(PENDING)
  items         Json           // [{productId, qty, qtyReceived}]
  requestedBy   String         @db.ObjectId
  approvedBy    String?        @db.ObjectId
  dispatchedAt  DateTime?
  receivedAt    DateTime?
  notes         String?
  createdAt     DateTime       @default(now())

  fromBranch    Branch         @relation("FromBranch", fields: [fromBranchId], references: [id])
  toBranch      Branch         @relation("ToBranch", fields: [toBranchId], references: [id])
  fromWarehouse Warehouse      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
}

model WasteRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  warehouseId String   @db.ObjectId
  branchId    String   @db.ObjectId
  qty         Float  
  reason      String
  costValue   Float   @default(0)
  recordedBy  String   @db.ObjectId
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id])
}

