// PROCUREMENT & SUPPLIERS
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model Supplier {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String?  @unique @db.ObjectId
  nameAr        String
  nameEn        String
  contactName   String?
  phone         String?
  email         String?
  address       Json?
  taxNumber     String?
  paymentTerms  String   @default("NET30")
  creditLimit   Float   @default(0)
  isActive      Boolean  @default(true)
  rating        Int?     // 1-5
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?         @relation(fields: [userId], references: [id])
  purchaseOrders PurchaseOrder[]
  invoices      SupplierInvoice[]
  ledgerEntries SupplierLedgerEntry[]
}

model PurchaseOrder {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  poNumber    String              @unique
  supplierId  String              @db.ObjectId
  branchId    String              @db.ObjectId
  status      PurchaseOrderStatus @default(DRAFT)
  items       PurchaseOrderItem[]
  subtotal    Float             
  taxAmount   Float              @default(0)
  total       Float             
  expectedDate DateTime?
  notes       String?
  approvedBy  String?             @db.ObjectId
  approvedAt  DateTime?
  createdBy   String              @db.ObjectId
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  receipts    GoodsReceipt[]
}

model PurchaseOrderItem {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  poId        String        @db.ObjectId
  productId   String        @db.ObjectId
  qtyOrdered  Float       
  qtyReceived Float        @default(0)
  unitCost    Float       
  total       Float       
  unit        String

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
}

model GoodsReceipt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  grNumber    String   @unique
  poId        String   @db.ObjectId
  warehouseId String   @db.ObjectId
  items       Json     // [{productId, qtyOrdered, qtyReceived, qtyRejected, lotNumber, expiryDate}]
  receivedBy  String   @db.ObjectId
  notes       String?
  createdAt   DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
}

model SupplierInvoice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String   @unique
  supplierId    String   @db.ObjectId
  poId          String?  @db.ObjectId
  amount        Float  
  taxAmount     Float   @default(0)
  total         Float  
  dueDate       DateTime
  paidAmount    Float   @default(0)
  status        String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  attachmentUrl String?
  createdAt     DateTime @default(now())

  supplier      Supplier @relation(fields: [supplierId], references: [id])
}

model SupplierLedgerEntry {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  supplierId    String   @db.ObjectId
  type          String   // INVOICE | PAYMENT | CREDIT_NOTE | ADJUSTMENT
  amount        Float  
  balance       Float  
  referenceType String?
  referenceId   String?  @db.ObjectId
  notes         String?
  createdAt     DateTime @default(now())

  supplier      Supplier @relation(fields: [supplierId], references: [id])
}

