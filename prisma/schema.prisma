// POS
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model POSSession {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  branchId        String        @db.ObjectId
  cashierId       String        @db.ObjectId
  openingBalance  Float       
  closingBalance  Float?      
  expectedBalance Float?      
  variance        Float?      
  status          SessionStatus @default(OPEN)
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  notes           String?

  branch          Branch          @relation(fields: [branchId], references: [id])
  cashier         User            @relation(fields: [cashierId], references: [id])
  transactions    POSTransaction[]
  cashMovements   CashMovement[]
}

model POSTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   String   @db.ObjectId
  orderId     String   @db.ObjectId
  type        String   @default("SALE") // SALE | RETURN | VOID
  total       Float  
  createdAt   DateTime @default(now())

  session     POSSession @relation(fields: [sessionId], references: [id])
}

model CashMovement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   String   @db.ObjectId
  type        String   // CASH_IN | CASH_OUT
  amount      Float  
  reason      String
  notes       String?
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())

  session     POSSession @relation(fields: [sessionId], references: [id])
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// FINANCE
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId       String?       @db.ObjectId
  amount        Float       
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?       // gateway transaction ID
  gatewayData   Json?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  order         SalesOrder?   @relation(fields: [orderId], references: [id])
  refunds       Refund[]
}

model Refund {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String   @db.ObjectId
  paymentId       String   @db.ObjectId
  amount          Float  
  reason          String
  method          PaymentMethod
  status          String   @default("PENDING") // PENDING | PROCESSED | FAILED
  processedBy     String   @db.ObjectId
  processedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())

  order           SalesOrder @relation(fields: [orderId], references: [id])
  payment         Payment    @relation(fields: [paymentId], references: [id])
}

model Invoice {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber   String   @unique
  orderId         String   @unique @db.ObjectId
  issuedAt        DateTime @default(now())
  dueDate         DateTime?
  subtotal        Float  
  taxAmount       Float  
  total           Float  
  paidAmount      Float   @default(0)
  status          String   @default("UNPAID") // UNPAID | PARTIAL | PAID | VOID
  snapshotData    Json

  order           SalesOrder @relation(fields: [orderId], references: [id])
}

model CustomerLedgerEntry {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String?  @db.ObjectId
  merchantId    String?  @db.ObjectId
  type          String   // CHARGE | PAYMENT | REFUND | CREDIT | ADJUSTMENT
  amount        Float  
  balance       Float  
  referenceType String?
  referenceId   String?  @db.ObjectId
  notes         String?
  createdAt     DateTime @default(now())

  customer      Customer?       @relation(fields: [customerId], references: [id])
  merchant      MerchantAccount? @relation(fields: [merchantId], references: [id])
  orderId       String?         @db.ObjectId
  order         SalesOrder?     @relation(fields: [orderId], references: [id])
}

model Expense {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  branchId    String          @db.ObjectId
  category    ExpenseCategory
  amount      Float         
  description String
  date        DateTime
  attachmentUrl String?
  recordedBy  String          @db.ObjectId
  approvedBy  String?         @db.ObjectId
  createdAt   DateTime        @default(now())

  branch      Branch          @relation(fields: [branchId], references: [id])
}

