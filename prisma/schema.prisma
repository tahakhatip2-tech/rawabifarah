// PRODUCTION & RECIPES
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model Recipe {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  productId       String   @unique @db.ObjectId
  version         Int      @default(1)
  yield           Float  
  yieldUnit       String
  instructionsAr  String?
  instructionsEn  String?
  overheadCost    Float   @default(0)
  estimatedCost   Float   @default(0)
  isActive        Boolean  @default(true)
  effectiveDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product            @relation(fields: [productId], references: [id])
  ingredients     RecipeIngredient[]
  productionOrders ProductionOrder[]
}

model RecipeIngredient {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  recipeId    String   @db.ObjectId
  productId   String   @db.ObjectId
  qty         Float  
  unit        String
  notes       String?

  recipe      Recipe   @relation(fields: [recipeId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model ProductionOrder {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String                @unique
  recipeId        String                @db.ObjectId
  branchId        String                @db.ObjectId
  status          ProductionOrderStatus @default(PLANNED)
  plannedQty      Float               
  actualQty       Float?              
  wasteQty        Float?              
  plannedDate     DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  batchNumber     String?
  expiryDate      DateTime?
  actualCost      Float?              
  consumptions    Json?                 // [{productId, plannedQty, actualQty}]
  notes           String?
  assignedTo      String?               @db.ObjectId
  createdBy       String                @db.ObjectId
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  recipe          Recipe                @relation(fields: [recipeId], references: [id])
  branch          Branch                @relation(fields: [branchId], references: [id])
}

// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ
// ORDERS & SALES
// â•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گâ•گ

model Cart {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String?    @db.ObjectId
  sessionId   String?
  items       CartItem[]
  couponCode  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CartItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId      String   @db.ObjectId
  productId   String   @db.ObjectId
  variantId   String?  @db.ObjectId
  qty         Int
  unitPrice   Float  

  cart        Cart     @relation(fields: [cartId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String       @unique
  customerId      String?      @db.ObjectId
  merchantId      String?      @db.ObjectId
  branchId        String       @db.ObjectId
  channel         OrderChannel
  status          OrderStatus  @default(PENDING)
  items           SalesOrderItem[]
  payments        Payment[]
  subtotal        Float      
  discountAmount  Float       @default(0)
  taxAmount       Float       @default(0)
  deliveryFee     Float       @default(0)
  total           Float      
  paidAmount      Float       @default(0)
  notes           String?
  couponId        String?      @db.ObjectId
  deliveryType    String       @default("PICKUP") // PICKUP | DELIVERY
  snapshotData    Json         // immutable snapshot of prices/products at order time
  cancelledReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer        Customer?       @relation(fields: [customerId], references: [id])
  merchant        MerchantAccount? @relation(fields: [merchantId], references: [id])
  branch          Branch          @relation(fields: [branchId], references: [id])
  delivery        Delivery?
  invoice         Invoice?
  refunds         Refund[]
  ledgerEntries   CustomerLedgerEntry[]
}

model SalesOrderItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId       String   @db.ObjectId
  productId     String   @db.ObjectId
  variantId     String?  @db.ObjectId
  nameAr        String   // snapshot
  nameEn        String   // snapshot
  qty           Float  
  unitPrice     Float  
  discount      Float   @default(0)
  taxRate       Float  
  total         Float  

  order         SalesOrder @relation(fields: [orderId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])
}

